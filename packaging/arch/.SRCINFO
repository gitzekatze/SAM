pkgbase = sam-jail
	pkgdesc = Flatseal-style sandbox manager for AppImages, using Bubblewrap
	pkgver = 0.1.0
	pkgrel = 1
	url = https://github.com/gitzekatze/SAM
	arch = x86_64
	arch = aarch64
	license = GPL-3.0-or-later
	checkdepends = bubblewrap
	makedepends = cargo
	makedepends = gtk4
	makedepends = libadwaita
	options = !lto
	source = sam-0.1.0.tar.gz::https://github.com/gitzekatze/SAM/releases/download/v0.1.0/sam-0.1.0.tar.gz
	source = sam-0.1.0-vendor.tar.xz::https://github.com/gitzekatze/SAM/releases/download/v0.1.0/sam-0.1.0-vendor.tar.xz
