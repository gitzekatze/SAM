pkgname = sam-jail-cli
	pkgdesc = Command line tools and sandbox runner for SAM, the Sandboxed AppImage Manager
	depends = bubblewrap
	depends = glibc
	depends = gcc-libs
	depends = libarchive
	optdepends = xdg-dbus-proxy: filtered session D-Bus for sandboxed apps (recommended)
	optdepends = passt: "Local network only" for sandboxed apps
	optdepends = squashfs-tools: additional SquashFS extractor
	optdepends = strace: diagnostic runs that find missing resources

pkgname = sam-jail
	pkgdesc = Flatseal-style sandbox manager for AppImages, using Bubblewrap (GTK 4 / libadwaita GUI)
	depends = sam-jail-cli=0.1.0
	depends = gtk4
	depends = libadwaita
	depends = hicolor-icon-theme
