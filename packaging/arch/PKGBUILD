# Maintainer: gitzekatze <206283406+gitzekatze@users.noreply.github.com>
#
# SAM - Sandboxed AppImage Manager. Split package:
#   sam-jail-cli   command line tools and sandbox runner (sam-jail, sam-jail-run)
#   sam-jail       the GTK 4 / libadwaita window (sam-jail-gui); "sam" is taken on the AUR
#
# Builds offline from two release files made by `scripts/make-release.sh`:
# the source and the vendored Rust crates. To test before a release is
# published, put both files next to this PKGBUILD (or in $SRCDEST) and run
# `makepkg -si`.

pkgbase=sam-jail
pkgname=(sam-jail-cli sam-jail)
pkgver=0.1.0
pkgrel=1
pkgdesc="SAM - Sandboxed AppImage Manager: Flatseal-style sandbox manager for AppImages"
arch=(x86_64 aarch64)
url="https://github.com/gitzekatze/SAM"
license=(GPL-3.0-or-later)
makedepends=(cargo gtk4 libadwaita)
checkdepends=(bubblewrap)
options=(!lto)
source=("sam-$pkgver.tar.gz::$url/releases/download/v$pkgver/sam-$pkgver.tar.gz"
        "sam-$pkgver-vendor.tar.xz::$url/releases/download/v$pkgver/sam-$pkgver-vendor.tar.xz")
sha256sums=('03795afa5d35c4be72de02390167d57350bcb13fdf490a897b7abd02d64fc81c'
            '6f31053708211a434a638e01f121062013edce5068598684b93b9085ca793396')

# makepkg's RUSTFLAGS plus a path remap that keeps the build folder out of
# the binaries (reproducible builds). Passed space-safe, because $srcdir may
# contain spaces.
_rustflags() {
  local flags=()
  read -ra flags <<< "${RUSTFLAGS:-}"
  flags+=("--remap-path-prefix=$srcdir=/usr/src/debug/$pkgbase")
  CARGO_ENCODED_RUSTFLAGS="$(IFS=$'\x1f'; echo "${flags[*]}")"
  export CARGO_ENCODED_RUSTFLAGS
  unset RUSTFLAGS
}

build() {
  cd "sam-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  _rustflags
  cargo build --frozen --offline --release -p sam-jail-cli -p sam-gtk
}

check() {
  cd "sam-$pkgver"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  _rustflags
  # The end-to-end sandbox tests skip themselves where Bubblewrap cannot run
  # (for example in a clean chroot without user namespaces).
  cargo test --frozen --offline --workspace
}

package_sam-jail-cli() {
  pkgdesc="Command line tools and sandbox runner of SAM - Sandboxed AppImage Manager"
  depends=(bubblewrap glibc gcc-libs libarchive)
  optdepends=(
    'xdg-dbus-proxy: filtered session D-Bus for sandboxed apps (recommended)'
    'passt: "Local network only" for sandboxed apps'
    'squashfs-tools: additional SquashFS extractor'
    'strace: diagnostic runs that find missing resources'
  )
  cd "sam-$pkgver"
  install -Dm755 target/release/sam-jail     "$pkgdir/usr/bin/sam-jail"
  install -Dm755 target/release/sam-jail-run "$pkgdir/usr/bin/sam-jail-run"
  install -Dm644 README.md          "$pkgdir/usr/share/doc/sam/README.md"
  install -Dm644 docs/security.md   "$pkgdir/usr/share/doc/sam/security.md"
  install -Dm644 docs/profiles.md   "$pkgdir/usr/share/doc/sam/profiles.md"
  install -Dm644 CHANGELOG.md       "$pkgdir/usr/share/doc/sam/CHANGELOG.md"
  for f in data/man/sam-jail*.1; do
    [ "${f##*/}" = sam-jail-gui.1 ] || install -Dm644 "$f" "$pkgdir/usr/share/man/man1/${f##*/}"
  done
}

package_sam-jail() {
  pkgdesc="SAM - Sandboxed AppImage Manager: Flatseal-style sandbox manager for AppImages (GTK 4 / libadwaita window)"
  depends=("sam-jail-cli=$pkgver" gtk4 libadwaita hicolor-icon-theme)
  cd "sam-$pkgver"
  install -Dm755 target/release/sam-jail-gui "$pkgdir/usr/bin/sam-jail-gui"
  install -Dm644 data/io.github.gitzekatze.SAM.desktop      "$pkgdir/usr/share/applications/io.github.gitzekatze.SAM.desktop"
  install -Dm644 data/io.github.gitzekatze.SAM.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.gitzekatze.SAM.metainfo.xml"
  install -Dm644 data/io.github.gitzekatze.SAM.svg          "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.gitzekatze.SAM.svg"
  install -Dm644 data/man/sam-jail-gui.1                    "$pkgdir/usr/share/man/man1/sam-jail-gui.1"
}
