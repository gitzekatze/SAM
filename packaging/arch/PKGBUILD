# Maintainer: SAM contributors
#
# Split package for CachyOS / Arch Linux (whitepaper §2.22.3):
#   sam      the GTK 4 / libadwaita GUI
#   sam-jail-cli  the command line tools and sandbox runner (required by sam)
#
# This PKGBUILD builds the source tree it lives in:
#   cd packaging/arch && makepkg -si
# For the AUR, replace `source=()` with the release tarball and its checksum.

pkgbase=sam
pkgname=(sam-jail-cli sam)
pkgver=0.1.0
pkgrel=1
pkgdesc="Flatseal-style permission manager and sandbox launcher for AppImages"
arch=(x86_64 aarch64)
url="https://github.com/gitzekatze/SAM"
license=(GPL-3.0-or-later)
makedepends=(cargo gtk4 libadwaita)
options=(!lto)
source=()
sha256sums=()

_srcroot() { realpath "$startdir/../.."; }

prepare() {
  cd "$(_srcroot)"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$(_srcroot)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  cargo build --frozen --release -p sam-jail-cli -p sam-gtk
}

check() {
  cd "$(_srcroot)"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR="$srcdir/target"
  # The end-to-end sandbox test skips itself when bubblewrap cannot run (e.g. in a chroot).
  cargo test --frozen --workspace
}

package_sam-jail-cli() {
  pkgdesc="Command line tools and sandbox runner for SAM"
  depends=(bubblewrap glibc gcc-libs libarchive)
  optdepends=(
    'xdg-dbus-proxy: filtered session D-Bus for sandboxed apps (recommended)'
    'squashfs-tools: additional SquashFS extractor'
    'strace: dynamic diagnosis of missing resources'
    'libnotify: launch error notifications'
  )
  cd "$(_srcroot)"
  install -Dm755 "$srcdir/target/release/sam-jail"     "$pkgdir/usr/bin/sam-jail"
  install -Dm755 "$srcdir/target/release/sam-jail-run" "$pkgdir/usr/bin/sam-jail-run"
  install -Dm644 README.md          "$pkgdir/usr/share/doc/sam/README.md"
  install -Dm644 docs/security.md   "$pkgdir/usr/share/doc/sam/security.md"
  install -Dm644 docs/profiles.md   "$pkgdir/usr/share/doc/sam/profiles.md"
}

package_sam() {
  pkgdesc="Flatseal-style permission manager for AppImages (GTK 4 / libadwaita GUI)"
  depends=(sam-jail-cli gtk4 libadwaita hicolor-icon-theme)
  cd "$(_srcroot)"
  install -Dm755 "$srcdir/target/release/sam-jail-gui" "$pkgdir/usr/bin/sam-jail-gui"
  install -Dm644 data/io.github.gitzekatze.SAM.desktop      "$pkgdir/usr/share/applications/io.github.gitzekatze.SAM.desktop"
  install -Dm644 data/io.github.gitzekatze.SAM.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.gitzekatze.SAM.metainfo.xml"
  install -Dm644 data/io.github.gitzekatze.SAM.svg          "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.gitzekatze.SAM.svg"
}
