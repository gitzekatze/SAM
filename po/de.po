#~ msgstr ""
#~ "strace ist nicht installiert; installiere es für die dynamische Diagnose "
#~ "(sudo pacman -S strace)"

#~ msgid ""
#~ "Check that user namespaces are enabled, or that AppArmor allows bwrap."
#~ msgstr ""
#~ "Prüfe, ob Benutzer-Namensräume eingeschaltet sind oder AppArmor bwrap "
#~ "erlaubt."

#~ msgid "Install it: sudo pacman -S bubblewrap"
#~ msgstr "Installiere es: sudo pacman -S bubblewrap"

#~ msgid "private home only"
#~ msgstr "nur der private Ordner"

#~ msgid "expected the \"previous\" object of `group set` as JSON on stdin"
#~ msgstr ""
#~ "das „previous“-Objekt von `group set` wurde als JSON auf stdin erwartet"

#~ msgid "Allow strict syscall filters (experimental)"
#~ msgstr "Strenge Systemaufruf-Filter erlauben (experimentell)"

