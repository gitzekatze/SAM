msgstr "steuert Container auf diesem Computer"

#: crates/sam-core/src/permissions.rs:439
msgid "is the system bus, unfiltered"
msgstr "ist der Systembus, ungefiltert"

#: crates/sam-core/src/permissions.rs:441
msgid "controls systemd"
msgstr "steuert systemd"

#: crates/sam-core/src/permissions.rs:444
