#~ "kernel.unprivileged_userns_clone=1"

#~ msgid ""
#~ "Allows the app to read and write all files in your home folder. This is "
#~ "high risk and usually not required."
#~ msgstr ""
#~ "Erlaubt der App, alle Dateien in deinem Persönlichen Ordner zu lesen und "
