msgstr ""
"PipeWire no está instalado, así que SAM no puede iniciar su intermediario de "
"sonido"

#: crates/sam-runner/src/sound_relay.rs:117
msgid "PipeWire is not running, so SAM cannot run its sound relay"
msgstr ""
"PipeWire no está en marcha, así que SAM no puede iniciar su intermediario de "
"sonido"

#: crates/sam-runner/src/sound_relay.rs:120
msgid "Bubblewrap is not installed, so SAM cannot run its sound relay"
msgstr ""
"Bubblewrap no está instalado, así que SAM no puede iniciar su intermediario "
"de sonido"

#. Keep the {placeholders}; their order may change.
#: crates/sam-runner/src/sound_relay.rs:137
msgid ""
"SAM's sound relay cannot run: the path for its socket is too long ({path})"
msgstr ""
"El intermediario de sonido de SAM no puede funcionar: la ruta de su socket "
"es demasiado larga ({path})"

#: crates/sam-runner/src/sound_relay.rs:160
msgid "starting SAM's sound relay"
msgstr "iniciando el intermediario de sonido de SAM"

#. Keep the {placeholders}; their order may change.
#: crates/sam-runner/src/sound_relay.rs:166
msgid "SAM's sound relay ended at its start ({status})"
msgstr "El intermediario de sonido de SAM terminó al iniciarse ({status})"

#: crates/sam-runner/src/sound_relay.rs:177
msgid "SAM's sound relay did not open its socket in time"
msgstr "El intermediario de sonido de SAM no abrió su socket a tiempo"

#: crates/sam-runner/src/updates.rs:45
msgid ""
"curl is not installed, so SAM cannot check for or download updates. Install "
"the package curl."
msgstr ""
"curl no está instalado, así que SAM no puede buscar ni descargar "
