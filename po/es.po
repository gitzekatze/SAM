msgid "Kernel-enforced write restrictions for this app."
msgstr ""
"Restricciones de escritura aplicadas por el núcleo para esta aplicación."

#: crates/sam-gtk/src/perms.rs:607
msgid "No Landlock restrictions for this app."
msgstr "Sin restricciones de Landlock para esta aplicación."

