# Spanish translation of SAM - Sandboxed AppImage Manager.
msgid ""
msgstr ""
"Project-Id-Version: sam\n"
"Report-Msgid-Bugs-To: https://github.com/gitzekatze/SAM/issues\n"
"Language: es\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/config.rs:234
msgid "{file}: {error}; that setting was reset"
msgstr "{file}: {error}; se restableció ese ajuste"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/config.rs:267
msgid ""
"{file} could not be read; it was moved to {moved} and the default settings "
"are used"
msgstr ""
"No se pudo leer {file}; se movió a {moved} y se usan los ajustes "
"predeterminados"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/config.rs:272
msgid "{file} could not be read; the default settings are used"
msgstr "No se pudo leer {file}; se usan los ajustes predeterminados"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/config.rs:290
msgid ""
"unknown language '{language}'; choose one of: {choices}, or leave it empty "
"to follow the system"
msgstr ""
"idioma desconocido «{language}»; elige uno de: {choices}, o déjalo vacío "
"para usar el del sistema"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/config.rs:299
msgid "unknown theme '{theme}'; choose one of: {choices}"
msgstr "tema desconocido «{theme}»; elige uno de estos: {choices}"

#: crates/sam-core/src/config.rs:317
msgid ""
"extraction.location must be an absolute path (or start with ~/), without '..'"
msgstr ""
"extraction.location debe ser una ruta absoluta (o empezar por ~/), sin «..»"

#: crates/sam-core/src/config.rs:320
msgid ""
"extraction.location cannot be / or the home folder itself; choose a folder "
"of its own"
msgstr ""
"extraction.location no puede ser / ni la propia carpeta personal; elige una "
"carpeta propia"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/config.rs:353 crates/sam-core/src/config.rs:370
#: crates/sam-core/src/config.rs:383
msgid "unknown config key '{key}'"
msgstr "clave de configuración desconocida «{key}»"

#: crates/sam-core/src/config.rs:364 crates/sam-core/src/permissions.rs:836
msgid "empty key"
msgstr "clave vacía"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/config.rs:377
msgid "'{key}' is not settable"
msgstr "«{key}» no se puede ajustar"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/config.rs:399 crates/sam-core/src/permissions.rs:862
msgid "invalid value for '{key}': {raw}"
msgstr "valor no válido para «{key}»: {raw}"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/format.rs:37
msgid ""
"{file} was written by a newer SAM (format {found}, this SAM knows up to "
"{known}); update SAM. The file was left unchanged."
msgstr ""
"{file} lo escribió un SAM más reciente (formato {found}; este SAM conoce "
"hasta el {known}); actualiza SAM. El archivo no se modificó."

#: crates/sam-core/src/host.rs:52
msgid ""
"User namespaces are disabled on this system (user.max_user_namespaces = 0). "
"Bubblewrap cannot create a sandbox."
msgstr ""
"Los espacios de nombres de usuario están desactivados en este sistema "
"(user.max_user_namespaces = 0). Bubblewrap no puede crear un entorno aislado."

#: crates/sam-core/src/host.rs:54
msgid ""
"Unprivileged user namespaces are disabled (kernel.unprivileged_userns_clone "
"= 0). Enable them with: sudo sysctl kernel.unprivileged_userns_clone=1"
msgstr ""
"Los espacios de nombres de usuario sin privilegios están desactivados "
"(kernel.unprivileged_userns_clone = 0). Actívelos con: sudo sysctl "
"kernel.unprivileged_userns_clone=1"

#: crates/sam-core/src/host.rs:56
msgid ""
"AppArmor restricts unprivileged user namespaces. Bubblewrap may need an "
"AppArmor profile (Ubuntu 24.04+)."
msgstr ""
"AppArmor restringe los espacios de nombres de usuario sin privilegios. Puede "
"que Bubblewrap necesite un perfil de AppArmor (Ubuntu 24.04 o posterior)."

#: crates/sam-core/src/host.rs:58
msgid "User namespaces are available."
msgstr "Los espacios de nombres de usuario están disponibles."

#: crates/sam-core/src/model.rs:213
msgid "This app can run, but meaningful isolation is limited."
msgstr "Esta aplicación puede funcionar, pero su aislamiento es limitado."

#: crates/sam-core/src/model.rs:214
msgid "This app probably cannot run correctly inside a sandbox."
msgstr ""
"Probablemente esta aplicación no funcione bien dentro de un entorno aislado."

#: crates/sam-core/src/model.rs:216
msgid ""
"This app requires access that cannot be safely sandboxed (it asks for "
"administrator rights)."
msgstr ""
"Esta aplicación necesita un acceso que no se puede aislar de forma segura "
"(pide derechos de administrador)."

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/permissions.rs:55
msgid "invalid access level '{other}' (expected none, ro or rw)"
msgstr "nivel de acceso no válido «{other}» (se esperaba none, ro o rw)"

#: crates/sam-core/src/permissions.rs:286
msgid "can start any program outside the sandbox"
msgstr "puede iniciar cualquier programa fuera del entorno aislado"

#: crates/sam-core/src/permissions.rs:290
#: crates/sam-core/src/permissions.rs:310
msgid "can start programs outside the sandbox"
msgstr "puede iniciar programas fuera del entorno aislado"

#: crates/sam-core/src/permissions.rs:294
msgid "can start new sandboxes and programs"
msgstr "puede iniciar nuevos entornos aislados y programas"

#: crates/sam-core/src/permissions.rs:298
msgid "bypasses the portal and its prompts"
msgstr "evita el portal y sus preguntas"

#: crates/sam-core/src/permissions.rs:302
msgid "can run scripts in the window manager"
msgstr "puede ejecutar scripts en el gestor de ventanas"

#: crates/sam-core/src/permissions.rs:306
#: crates/sam-core/src/permissions.rs:327
msgid "can run scripts in the desktop shell"
msgstr "puede ejecutar scripts en el entorno de escritorio"

#: crates/sam-core/src/permissions.rs:314
msgid "controls desktop background services"
msgstr "controla los servicios en segundo plano del escritorio"

#: crates/sam-core/src/permissions.rs:316
msgid "can run commands"
msgstr "puede ejecutar órdenes"

#: crates/sam-core/src/permissions.rs:319
msgid "controls the session (log out, restore programs)"
msgstr "controla la sesión (cerrar sesión, restaurar programas)"

#: crates/sam-core/src/permissions.rs:323
msgid "can register global shortcuts and observe key presses"
msgstr "puede registrar atajos globales y observar las pulsaciones de teclas"

#: crates/sam-core/src/permissions.rs:331
msgid "controls the session"
msgstr "controla la sesión"

#: crates/sam-core/src/permissions.rs:335
msgid "can change any desktop setting, including autostart"
msgstr ""
"puede cambiar cualquier ajuste del escritorio, incluido el inicio automático"

#: crates/sam-core/src/permissions.rs:349
msgid "controls Docker, which equals full control of the computer"
msgstr "controla Docker, lo que equivale al control total del equipo"

#: crates/sam-core/src/permissions.rs:353
msgid "controls Podman containers on this computer"
msgstr "controla los contenedores de Podman de este equipo"

#: crates/sam-core/src/permissions.rs:357
msgid "controls containers on this computer"
msgstr "controla los contenedores de este equipo"

#: crates/sam-core/src/permissions.rs:361
msgid "is the system bus, unfiltered"
msgstr "es el bus del sistema, sin filtrar"

#: crates/sam-core/src/permissions.rs:363
msgid "controls systemd"
msgstr "controla systemd"

#: crates/sam-core/src/permissions.rs:366
msgid "is a D-Bus socket, which bypasses SAM's D-Bus filter"
msgstr "es un socket de D-Bus, que evita el filtro de D-Bus de SAM"

#: crates/sam-core/src/permissions.rs:368
msgid "controls virtual machines"
msgstr "controla máquinas virtuales"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/permissions.rs:414
msgid "{name} belongs to the desktop's own protocols"
msgstr "{name} pertenece a los protocolos propios del escritorio"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/permissions.rs:424
msgid ""
"{name} is a service on this computer that starts on demand; owning it would "
"intercept its requests"
msgstr ""
"{name} es un servicio de este equipo que se inicia cuando se necesita; "
"ocuparlo interceptaría sus solicitudes"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/permissions.rs:434
msgid "{name} covers services that can act outside the sandbox"
msgstr "{name} abarca servicios que pueden actuar fuera del entorno aislado"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/permissions.rs:824
#: crates/sam-core/src/permissions.rs:842
#: crates/sam-core/src/permissions.rs:856
msgid "unknown permission key '{key}'"
msgstr "clave de permiso desconocida «{key}»"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/permissions.rs:849
msgid "'{key}' is not a settable key"
msgstr "«{key}» no es una clave ajustable"

#: crates/sam-core/src/permissions.rs:929 crates/sam-core/src/risk.rs:125
#: crates/sam-core/src/warnings.rs:127
msgid "Full home access"
msgstr "Acceso completo a la carpeta personal"

#: crates/sam-core/src/permissions.rs:929
msgid ""
"Allows the app to read and write all files in your home folder. This is high "
"risk and usually not required."
msgstr ""
"Permite que la aplicación lea y modifique todos los archivos de tu carpeta "
"personal. Es muy arriesgado y no suele hacer falta."

#: crates/sam-core/src/permissions.rs:931
msgid "Home access level"
msgstr "Nivel de acceso a la carpeta personal"

#: crates/sam-core/src/permissions.rs:931
msgid "Whether full home access is read-only or read/write."
msgstr ""
"Si el acceso completo a la carpeta personal es de solo lectura o de lectura "
"y escritura."

#: crates/sam-core/src/permissions.rs:933
msgid "Documents"
msgstr "Documentos"

#: crates/sam-core/src/permissions.rs:933
msgid "Lets the app open and save files in your Documents folder."
msgstr ""
"Permite que la aplicación abra y guarde archivos en tu carpeta Documentos."

#: crates/sam-core/src/permissions.rs:935
msgid "Downloads"
msgstr "Descargas"

#: crates/sam-core/src/permissions.rs:935
msgid "Lets the app open and save files in your Downloads folder."
msgstr ""
"Permite que la aplicación abra y guarde archivos en tu carpeta Descargas."

#: crates/sam-core/src/permissions.rs:937
msgid "Music"
msgstr "Música"

#: crates/sam-core/src/permissions.rs:937
msgid "Lets the app access your Music folder."
msgstr "Permite que la aplicación acceda a tu carpeta Música."

#: crates/sam-core/src/permissions.rs:939
msgid "Pictures"
msgstr "Imágenes"

#: crates/sam-core/src/permissions.rs:939
msgid "Lets the app access your Pictures folder."
msgstr "Permite que la aplicación acceda a tu carpeta Imágenes."

#: crates/sam-core/src/permissions.rs:941
msgid "Videos"
msgstr "Vídeos"

#: crates/sam-core/src/permissions.rs:941
msgid "Lets the app access your Videos folder."
msgstr "Permite que la aplicación acceda a tu carpeta Vídeos."

#: crates/sam-core/src/permissions.rs:943
msgid "Desktop folder"
msgstr "Carpeta del escritorio"

#: crates/sam-core/src/permissions.rs:943
msgid "Lets the app access files on your Desktop."
msgstr "Permite que la aplicación acceda a los archivos de tu escritorio."

#: crates/sam-core/src/permissions.rs:945 crates/sam-core/src/risk.rs:131
msgid "SSH keys"
msgstr "Claves SSH"

#: crates/sam-core/src/permissions.rs:945
msgid ""
"With full home access, also exposes ~/.ssh. Your SSH private keys could be "
"stolen."
msgstr ""
"Con acceso completo a la carpeta personal, también deja ver ~/.ssh. Podrían "
"robarse tus claves SSH privadas."

#: crates/sam-core/src/permissions.rs:947 crates/sam-core/src/risk.rs:139
msgid "GnuPG keys"
msgstr "Claves GnuPG"

#: crates/sam-core/src/permissions.rs:947
msgid ""
"With full home access, also exposes ~/.gnupg. Your PGP private keys could be "
"stolen."
msgstr ""
"Con acceso completo a la carpeta personal, también deja ver ~/.gnupg. "
"Podrían robarse tus claves PGP privadas."

#: crates/sam-core/src/permissions.rs:949 crates/sam-core/src/risk.rs:147
msgid "Sensitive dotfiles"
msgstr "Archivos ocultos sensibles"

#: crates/sam-core/src/permissions.rs:949
msgid ""
"With full home access, also exposes keyrings, password stores and cloud "
"credentials."
msgstr ""
"Con acceso completo a la carpeta personal, también deja ver depósitos de "
"claves, almacenes de contraseñas y credenciales de servicios en la nube."

#: crates/sam-core/src/permissions.rs:951
msgid "Files you open with the app"
msgstr "Archivos que abre con la aplicación"

#: crates/sam-core/src/permissions.rs:951
msgid ""
"Files you open with this app (for example with 'Open with' in the file "
"manager). Read & write lets it save them; read-only lets it only view them."
msgstr ""
"Archivos que abre con esta aplicación (por ejemplo con «Abrir con» en el "
"gestor de archivos). Con lectura y escritura puede guardarlos; con solo "
"lectura, solo verlos."

#: crates/sam-core/src/permissions.rs:953
msgid "Extra read-only folders"
msgstr "Más carpetas de solo lectura"

#: crates/sam-core/src/permissions.rs:953
msgid "Additional folders the app can read but not change."
msgstr "Carpetas adicionales que la aplicación puede leer, pero no modificar."

#: crates/sam-core/src/permissions.rs:955
msgid "Extra read/write folders"
msgstr "Más carpetas de lectura y escritura"

#: crates/sam-core/src/permissions.rs:955
msgid "Additional folders the app can read and change."
msgstr "Carpetas adicionales que la aplicación puede leer y modificar."

#: crates/sam-core/src/permissions.rs:957
msgid "Network access"
msgstr "Acceso a la red"

#: crates/sam-core/src/permissions.rs:957
msgid ""
"'Full network' shares your internet connection with the app. 'This computer "
"only' blocks the internet and the local network, but keeps the services on "
"this computer that you list reachable (for example a local AI model), and "
"the app's own web page opens in your browser. 'No network' gives the app no "
"connection at all."
msgstr ""
"«Red completa» comparte tu conexión a internet con la aplicación. «Solo este "
"equipo» bloquea internet y la red local, pero deja accesibles los servicios "
"de este equipo que indiques (por ejemplo un modelo de IA local), y la página "
"web propia de la aplicación se abre en tu navegador. «Sin red» no da ninguna "
"conexión a la aplicación."

#: crates/sam-core/src/permissions.rs:959
msgid "Local services the app may reach"
msgstr "Servicios locales a los que puede acceder la aplicación"

#: crates/sam-core/src/permissions.rs:959
msgid ""
"With 'This computer only': ports on this computer the app may connect to, "
"for example 11434 for Ollama or 1234 for LM Studio. Nothing else on your "
"computer is reachable."
msgstr ""
"Con «Solo este equipo»: puertos de este equipo a los que puede conectarse la "
"aplicación, por ejemplo 11434 para Ollama o 1234 para LM Studio. No se puede "
"acceder a nada más de tu equipo."

#: crates/sam-core/src/permissions.rs:961
msgid "The app's own ports"
msgstr "Puertos propios de la aplicación"

#: crates/sam-core/src/permissions.rs:961
msgid ""
"With 'This computer only': ports of the app (for example its web page) "
"reachable from this computer. When empty, SAM detects them, except "
"privileged ports and well-known local services."
msgstr ""
"Con «Solo este equipo»: puertos de la aplicación (por ejemplo su página web) "
"accesibles desde este equipo. Si se deja vacío, SAM los detecta, salvo los "
"puertos privilegiados y los servicios locales conocidos."

#: crates/sam-core/src/permissions.rs:963 crates/sam-core/src/risk.rs:202
msgid "GPU acceleration"
msgstr "Aceleración por GPU"

#: crates/sam-core/src/permissions.rs:963
msgid ""
"Hardware-accelerated graphics through /dev/dri and host graphics drivers. "
"Needed by most games, browsers and editors."
msgstr ""
"Gráficos acelerados por hardware mediante /dev/dri y los controladores "
"gráficos del sistema. La mayoría de juegos, navegadores y editores los "
"necesitan."

#: crates/sam-core/src/permissions.rs:965 crates/sam-core/src/risk.rs:210
#: crates/sam-runner/src/verify.rs:337
msgid "Webcam"
msgstr "Cámara web"

#: crates/sam-core/src/permissions.rs:965
msgid "Access to video capture devices. The app could record you."
msgstr ""
"Acceso a dispositivos de captura de vídeo. La aplicación podría grabarle."

#: crates/sam-core/src/permissions.rs:967 crates/sam-core/src/risk.rs:213
msgid "Game controllers"
msgstr "Mandos de juego"

#: crates/sam-core/src/permissions.rs:967
msgid ""
"Gamepads and joysticks that are plugged in when the app starts. Keyboards "
"and mice stay hidden."
msgstr ""
"Mandos y joysticks conectados cuando se inicia la aplicación. Los teclados y "
"ratones siguen ocultos."

#: crates/sam-core/src/permissions.rs:969 crates/sam-core/src/risk.rs:221
#: crates/sam-runner/src/verify.rs:351
msgid "All input devices"
msgstr "Todos los dispositivos de entrada"

#: crates/sam-core/src/permissions.rs:969
msgid ""
"Raw access to every keyboard, mouse and controller in /dev/input. Can be "
"used to read keystrokes. Only for tools that remap or configure input "
"devices."
msgstr ""
"Acceso directo a todos los teclados, ratones y mandos de /dev/input. Puede "
"usarse para leer las pulsaciones de teclas. Solo para herramientas que "
"reasignan o configuran dispositivos de entrada."

#: crates/sam-core/src/permissions.rs:971 crates/sam-core/src/risk.rs:229
#: crates/sam-runner/src/verify.rs:388
msgid "Raw USB"
msgstr "USB directo"

#: crates/sam-core/src/permissions.rs:971
msgid ""
"Raw access to USB devices. Needed by flashing tools and some hardware "
"utilities."
msgstr ""
"Acceso directo a dispositivos USB. Lo necesitan las herramientas de "
"grabación de firmware y algunas utilidades de hardware."

#: crates/sam-core/src/permissions.rs:973 crates/sam-core/src/risk.rs:232
#: crates/sam-core/src/warnings.rs:232
msgid "Bluetooth"
msgstr "Bluetooth"

#: crates/sam-core/src/permissions.rs:973
msgid "Bluetooth needs the system D-Bus and cannot be isolated well."
msgstr "Bluetooth necesita el D-Bus del sistema y no se puede aislar bien."

#: crates/sam-core/src/permissions.rs:975 crates/sam-core/src/risk.rs:240
#: crates/sam-runner/src/verify.rs:301
msgid "Sound"
msgstr "Sonido"

#: crates/sam-core/src/permissions.rs:975
msgid ""
"Play and record audio (through PipeWire's PulseAudio service). Recording is "
"possible once this is on."
msgstr ""
"Reproducir y grabar sonido (mediante el servicio PulseAudio de PipeWire). "
"Una vez activado, también se puede grabar."

#: crates/sam-core/src/permissions.rs:977 crates/sam-core/src/risk.rs:251
#: crates/sam-runner/src/verify.rs:311
msgid "Direct PipeWire access"
msgstr "Acceso directo a PipeWire"

#: crates/sam-core/src/permissions.rs:977
msgid ""
"The full PipeWire connection. Besides sound it reaches cameras and screen-"
"cast streams of other apps, bypassing the webcam and screen sharing "
"settings. Only for apps that support nothing else."
msgstr ""
"La conexión completa a PipeWire. Además del sonido, llega a las cámaras y a "
"las transmisiones de pantalla de otras aplicaciones, sin pasar por los "
"ajustes de cámara web y de compartir pantalla. Solo para aplicaciones que no "
"admiten otra cosa."

#: crates/sam-core/src/permissions.rs:979 crates/sam-core/src/risk.rs:259
#: crates/sam-runner/src/verify.rs:399
msgid "Raw ALSA devices"
msgstr "Dispositivos ALSA directos"

#: crates/sam-core/src/permissions.rs:979
msgid ""
"Direct sound card access. Only needed by apps that do not support PipeWire/"
"PulseAudio."
msgstr ""
"Acceso directo a la tarjeta de sonido. Solo lo necesitan las aplicaciones "
"que no admiten PipeWire ni PulseAudio."

#: crates/sam-core/src/permissions.rs:981 crates/sam-core/src/risk.rs:267
#: crates/sam-runner/src/verify.rs:285
msgid "Wayland"
msgstr "Wayland"

#: crates/sam-core/src/permissions.rs:981
msgid ""
"Show windows through the Wayland compositor. Wayland isolates apps from each "
"other."
msgstr ""
"Mostrar ventanas mediante el compositor de Wayland. Wayland mantiene las "
"aplicaciones separadas entre sí."

#: crates/sam-core/src/permissions.rs:983 crates/sam-core/src/risk.rs:243
msgid "Privileged Wayland protocols"
msgstr "Protocolos privilegiados de Wayland"

#: crates/sam-core/src/permissions.rs:983
msgid ""
"Lets the app use Wayland functions the desktop normally hides from sandboxed "
"apps: reading the clipboard in the background, capturing the screen, typing "
"as a virtual keyboard. Only for clipboard managers, screenshot and remote-"
"control tools."
msgstr ""
"Permite que la aplicación use funciones de Wayland que el escritorio oculta "
"a las aplicaciones aisladas: leer el portapapeles en segundo plano, capturar "
"la pantalla, escribir como un teclado virtual. Solo para gestores del "
"portapapeles y herramientas de captura de pantalla o control remoto."

#: crates/sam-core/src/permissions.rs:985 crates/sam-core/src/risk.rs:318
#: crates/sam-runner/src/verify.rs:293
msgid "X11 / XWayland"
msgstr "X11 / XWayland"

#: crates/sam-core/src/permissions.rs:985 crates/sam-core/src/warnings.rs:104
msgid ""
"X11 access allows the app to observe input and other windows. Wayland is "
"safer, but some apps may require XWayland."
msgstr ""
"El acceso a X11 permite que la aplicación observe las entradas y otras "
"ventanas. Wayland es más seguro, pero algunas aplicaciones necesitan "
"XWayland."

#: crates/sam-core/src/permissions.rs:987 crates/sam-runner/src/verify.rs:424
msgid "Session bus"
msgstr "Bus de sesión"

#: crates/sam-core/src/permissions.rs:987
msgid ""
"'filtered' only allows portals, notifications and the tray. 'full' lets the "
"app talk to every desktop service, which is high risk."
msgstr ""
"«filtered» solo permite portales, notificaciones y la bandeja del sistema. "
"«full» deja que la aplicación hable con cualquier servicio del escritorio, "
"lo que es muy arriesgado."

#: crates/sam-core/src/permissions.rs:989
msgid "Allowed session names"
msgstr "Nombres de sesión permitidos"

#: crates/sam-core/src/permissions.rs:989
msgid "Bus names reachable in filtered mode."
msgstr "Nombres de bus accesibles en el modo filtrado."

#: crates/sam-core/src/permissions.rs:991 crates/sam-runner/src/verify.rs:475
msgid "System bus"
msgstr "Bus del sistema"

#: crates/sam-core/src/permissions.rs:991
msgid ""
"The system bus controls hardware, networking and power. Denied by default."
msgstr ""
"El bus del sistema controla el hardware, la red y la energía. Bloqueado de "
"forma predeterminada."

#: crates/sam-core/src/permissions.rs:993 crates/sam-core/src/risk.rs:270
msgid "Passwords & keyring"
msgstr "Contraseñas y depósito de claves"

#: crates/sam-core/src/permissions.rs:993
msgid ""
"Lets the app store logins in your keyring or KWallet. The keyring does not "
"separate apps: the app can read every password stored there."
msgstr ""
"Permite que la aplicación guarde credenciales en tu depósito de claves o en "
"KWallet. El depósito de claves no separa las aplicaciones: la aplicación "
"puede leer todas las contraseñas guardadas allí."

#: crates/sam-core/src/permissions.rs:995 crates/sam-core/src/risk.rs:278
msgid "Media controls"
msgstr "Controles multimedia"

#: crates/sam-core/src/permissions.rs:995
msgid ""
"Media keys and 'now playing' in the panel, and keeping the screen awake "
"during playback."
msgstr ""
"Teclas multimedia y «Reproduciendo ahora» en el panel, y la pantalla se "
"mantiene encendida durante la reproducción."

#: crates/sam-core/src/permissions.rs:997 crates/sam-core/src/risk.rs:286
msgid "Screen sharing"
msgstr "Compartir pantalla"

#: crates/sam-core/src/permissions.rs:997
msgid ""
"Lets the app ask to share your screen or a window (video calls, streaming). "
"Your desktop always asks which screen or window first."
msgstr ""
"Permite que la aplicación pida compartir tu pantalla o una ventana "
"(videollamadas, retransmisiones). Tu escritorio siempre pregunta antes qué "
"pantalla o ventana."

#: crates/sam-core/src/permissions.rs:999 crates/sam-core/src/risk.rs:302
msgid "Open the file manager"
msgstr "Abrir el gestor de archivos"

#: crates/sam-core/src/permissions.rs:999
msgid ""
"Lets the app open your file manager and show a file it saved there (\"Show "
"in folder\")."
msgstr ""
"Permite que la aplicación abra tu gestor de archivos y muestre allí un "
"archivo que haya guardado («Mostrar en la carpeta»)."

#: crates/sam-core/src/permissions.rs:1001 crates/sam-core/src/risk.rs:294
msgid "Input method"
msgstr "Método de entrada"

#: crates/sam-core/src/permissions.rs:1001
msgid ""
"Typing through Fcitx5 or IBus (their sandbox frontends), for example for "
"Chinese, Japanese or Korean, and emoji pickers."
msgstr ""
"Escribir con Fcitx5 o IBus (mediante sus interfaces para entornos aislados), "
"por ejemplo para chino, japonés o coreano, y selectores de emoji."

#: crates/sam-core/src/permissions.rs:1003 crates/sam-core/src/risk.rs:371
#: crates/sam-runner/src/verify.rs:488
msgid "SSH agent"
msgstr "Agente SSH"

#: crates/sam-core/src/permissions.rs:1003
msgid "Lets the app use keys loaded in your SSH agent."
msgstr "Permite que la aplicación use las claves cargadas en tu agente SSH."

#: crates/sam-core/src/permissions.rs:1005 crates/sam-core/src/risk.rs:379
#: crates/sam-runner/src/verify.rs:498
msgid "Printing"
msgstr "Impresión"

#: crates/sam-core/src/permissions.rs:1005
msgid "Access to the CUPS printing service."
msgstr "Acceso al servicio de impresión CUPS."

#: crates/sam-core/src/permissions.rs:1007
msgid "Extra sockets"
msgstr "Sockets adicionales"

#: crates/sam-core/src/permissions.rs:1007
msgid ""
"Paths of other service sockets the app may connect to, for example a "
"password manager's browser connection. The app can do whatever that service "
"allows. Only real socket files are passed into the sandbox."
msgstr ""
"Rutas de sockets de otros servicios a los que puede conectarse la "
"aplicación, por ejemplo la conexión con el navegador de un gestor de "
"contraseñas. La aplicación puede hacer todo lo que ese servicio permita. "
"Solo se pasan al entorno aislado archivos de socket reales."

#: crates/sam-core/src/permissions.rs:1009
msgid "Names the app may own"
msgstr "Nombres que la aplicación puede ocupar"

#: crates/sam-core/src/permissions.rs:1009
msgid ""
"Extra bus names the app may register with the filtered session bus, for apps "
"that do not start without their own name. Owning a well-known name lets the "
"app pose as that service."
msgstr ""
"Nombres de bus adicionales que la aplicación puede registrar en el bus de "
"sesión filtrado, para aplicaciones que no se inician sin su propio nombre. "
"Ocupar un nombre conocido permite hacerse pasar por ese servicio."

#: crates/sam-core/src/permissions.rs:1011
msgid "Always blocked names"
msgstr "Nombres siempre bloqueados"

#: crates/sam-core/src/permissions.rs:1011
msgid ""
"Bus names that stay blocked even when a preset or another setting allows "
"them."
msgstr ""
"Nombres de bus que siguen bloqueados aunque una plantilla u otro ajuste los "
"permita."

#: crates/sam-core/src/permissions.rs:1013
msgid "Passed-through variables"
msgstr "Variables transmitidas"

#: crates/sam-core/src/permissions.rs:1013
msgid "Host environment variables made visible to the app."
msgstr "Variables de entorno del sistema que la aplicación puede ver."

#: crates/sam-core/src/permissions.rs:1015
msgid "Host runtime exposure"
msgstr "Visibilidad del sistema"

#: crates/sam-core/src/permissions.rs:1015
msgid ""
"'minimal' exposes system libraries and a whitelist of shared data. 'full' "
"exposes all of /usr read-only (compatibility)."
msgstr ""
"«minimal» muestra las bibliotecas del sistema y una lista de datos "
"compartidos. «full» muestra todo /usr en solo lectura (por compatibilidad)."

#: crates/sam-core/src/permissions.rs:1017
msgid "Persistent private home"
msgstr "Conservar la carpeta privada"

#: crates/sam-core/src/permissions.rs:1017
msgid "Keep the app's own private settings folder between runs."
msgstr ""
"Conservar la carpeta privada de ajustes de la aplicación entre ejecuciones."

#: crates/sam-core/src/permissions.rs:1019
msgid "Landlock enforcement"
msgstr "Protección Landlock"

#: crates/sam-core/src/permissions.rs:1019
msgid ""
"Kernel-enforced write restrictions as an extra layer. Unset follows the "
"global setting."
msgstr ""
"Restricciones de escritura aplicadas por el núcleo como capa adicional. Si "
"no se establece, sigue el ajuste general."

#: crates/sam-core/src/permissions.rs:1021
msgid "Strict syscall filter"
msgstr "Filtro estricto de llamadas al sistema"

#: crates/sam-core/src/permissions.rs:1021
msgid ""
"Experimental: blocks rarely needed, dangerous system calls. Can break apps."
msgstr ""
"Experimental: bloquea llamadas al sistema peligrosas que rara vez se "
"necesitan. Puede romper aplicaciones."

#: crates/sam-core/src/permissions.rs:1023 crates/sam-gtk/src/pages.rs:230
msgid "Baseline syscall filter"
msgstr "Filtro básico de llamadas al sistema"

#: crates/sam-core/src/permissions.rs:1023
msgid ""
"Blocks kernel interfaces no desktop app needs (modules, BPF, perf, keyrings, "
"io_uring, terminal injection). Turn off only if an app fails because of it."
msgstr ""
"Bloquea interfaces del núcleo que ninguna aplicación de escritorio necesita "
"(módulos, BPF, perf, anillos de claves, io_uring, inyección en el terminal). "
"Desactívelo solo si una aplicación falla por ello."

#: crates/sam-core/src/permissions.rs:1025
msgid "Nested namespaces"
msgstr "Espacios de nombres anidados"

#: crates/sam-core/src/permissions.rs:1025
msgid "Lets Chromium/Electron apps start their own internal sandbox."
msgstr ""
"Permite que las aplicaciones de Chromium y Electron inicien su propio "
"entorno aislado interno."

#: crates/sam-core/src/permissions.rs:1027
msgid "Host theme settings"
msgstr "Ajustes de tema del sistema"

#: crates/sam-core/src/permissions.rs:1027
msgid ""
"Read-only access to GTK/Qt/KDE theme configuration so apps match your "
"desktop."
msgstr ""
"Acceso de solo lectura a la configuración de temas de GTK, Qt y KDE, para "
"que las aplicaciones combinen con tu escritorio."

#: crates/sam-core/src/permissions.rs:1029 crates/sam-core/src/risk.rs:310
#: crates/sam-runner/src/doctor.rs:316 crates/sam-runner/src/doctor.rs:318
#: crates/sam-runner/src/doctor.rs:325 crates/sam-runner/src/repair.rs:679
msgid "Writable app folder"
msgstr "Carpeta de la aplicación con escritura"

#: crates/sam-core/src/permissions.rs:1029
msgid ""
"For portable apps that save settings next to themselves. Changes go to a "
"separate layer; the unpacked app stays untouched."
msgstr ""
"Para aplicaciones portátiles que guardan sus ajustes junto a ellas. Los "
"cambios van a una capa aparte; la aplicación desempaquetada no se toca."

#: crates/sam-core/src/permissions.rs:1031
msgid "System copies of libraries"
msgstr "Copias del sistema de bibliotecas"

#: crates/sam-core/src/permissions.rs:1031
msgid ""
"Replaces these bundled libraries with your system's copies, read-only. For "
"apps that bundle a library too old for your system."
msgstr ""
"Sustituye estas bibliotecas incluidas por las copias de tu sistema, en solo "
"lectura. Para aplicaciones que incluyen una biblioteca demasiado antigua "
"para tu sistema."

#: crates/sam-core/src/permissions.rs:1033 crates/sam-core/src/risk.rs:398
msgid "Raw Bubblewrap arguments"
msgstr "Argumentos directos de Bubblewrap"

#: crates/sam-core/src/permissions.rs:1033
msgid "Arguments passed verbatim to Bubblewrap. Can weaken the sandbox."
msgstr ""
"Argumentos que se pasan sin cambios a Bubblewrap. Pueden debilitar el "
"entorno aislado."

#: crates/sam-core/src/risk.rs:98
msgid "Fonts (read-only)"
msgstr "Tipos de letra (solo lectura)"

#: crates/sam-core/src/risk.rs:104
msgid "Locale and timezone (read-only)"
msgstr "Idioma y zona horaria (solo lectura)"

#: crates/sam-core/src/risk.rs:110
msgid "Icons and themes (read-only)"
msgstr "Iconos y temas (solo lectura)"

#: crates/sam-core/src/risk.rs:127
msgid "Full home access (read-only)"
msgstr "Acceso completo a la carpeta personal (solo lectura)"

#: crates/sam-core/src/risk.rs:191 crates/sam-gtk/src/all_perms.rs:39
#: crates/sam-gtk/src/perms.rs:623 crates/sam-profile/src/tags.rs:118
#: crates/sam-runner/src/repair.rs:577
msgid "Full network"
msgstr "Red completa"

#: crates/sam-core/src/risk.rs:192 crates/sam-gtk/src/all_perms.rs:38
#: crates/sam-gtk/src/perms.rs:616 crates/sam-profile/src/tags.rs:119
#: crates/sam-runner/src/doctor.rs:328 crates/sam-runner/src/doctor.rs:334
msgid "This computer only"
msgstr "Solo este equipo"

#: crates/sam-core/src/risk.rs:322
msgid "Session bus: filtered"
msgstr "Bus de sesión: filtrado"

#: crates/sam-core/src/risk.rs:328 crates/sam-profile/src/tags.rs:112
#: crates/sam-runner/src/repair.rs:578
msgid "Session bus: full access"
msgstr "Bus de sesión: acceso completo"

#: crates/sam-core/src/risk.rs:363 crates/sam-profile/src/tags.rs:115
msgid "System bus: full access"
msgstr "Bus del sistema: acceso completo"

#: crates/sam-core/src/risk.rs:390 crates/sam-gtk/src/perms.rs:832
#: crates/sam-runner/src/repair.rs:579
msgid "All of /usr"
msgstr "Todo /usr"

#: crates/sam-core/src/util.rs:60
msgid "path has no parent"
msgstr "la ruta no tiene carpeta superior"

#: crates/sam-core/src/warnings.rs:90
msgid "D-Bus wildcard not used"
msgstr "Comodín de D-Bus no usado"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/warnings.rs:93
msgid ""
"{names} would also reach a name you blocked, and the D-Bus filter cannot "
"make exceptions, so SAM does not allow it. List the services you need one by "
"one."
msgstr ""
"{names} también llegaría a un nombre que bloqueaste, y el filtro de D-Bus no "
"puede hacer excepciones, así que SAM no lo permite. Indica uno por uno los "
"servicios que necesites."

#: crates/sam-core/src/warnings.rs:104
msgid "X11 access"
msgstr "Acceso a X11"

#: crates/sam-core/src/warnings.rs:113
msgid "Terminal program"
msgstr "Programa de terminal"

#: crates/sam-core/src/warnings.rs:119
msgid "No display access"
msgstr "Sin acceso a la pantalla"

#: crates/sam-core/src/warnings.rs:119
msgid ""
"The app cannot open windows. This is only correct for command-line tools."
msgstr ""
"La aplicación no puede abrir ventanas. Solo es correcto para herramientas de "
"línea de órdenes."

#: crates/sam-core/src/warnings.rs:127
msgid ""
"The app can read and write every file in your home folder, including other "
"apps' settings. This is high risk and usually not required."
msgstr ""
"La aplicación puede leer y modificar cualquier archivo de tu carpeta "
"personal, incluidos los ajustes de otras aplicaciones. Es muy arriesgado y "
"no suele hacer falta."

#: crates/sam-core/src/warnings.rs:135
msgid "Private keys exposed"
msgstr "Claves privadas expuestas"

#: crates/sam-core/src/warnings.rs:135
msgid "SSH keys, GnuPG keys or other credential stores are visible to the app."
msgstr ""
"Las claves SSH, las claves GnuPG u otros almacenes de credenciales son "
"visibles para la aplicación."

#: crates/sam-core/src/warnings.rs:150
msgid "Sensitive path exposed"
msgstr "Ruta sensible expuesta"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/warnings.rs:153
msgid ""
"'{path}' contains system or credential data. Exposing it weakens the sandbox "
"significantly."
msgstr ""
"«{path}» contiene datos del sistema o credenciales. Exponerlo debilita mucho "
"el entorno aislado."

#: crates/sam-core/src/warnings.rs:161
msgid "Network may not be needed"
msgstr "Puede que no necesite la red"

#: crates/sam-core/src/warnings.rs:161
msgid ""
"This app does not appear to need the network. Consider setting network "
"access to 'none'."
msgstr ""
"Esta aplicación no parece necesitar la red. Considere poner el acceso a la "
"red en «Sin red»."

#: crates/sam-core/src/warnings.rs:171
msgid "Network is off"
msgstr "La red está desactivada"

#: crates/sam-core/src/warnings.rs:171
msgid ""
"This app looks like it uses the network. Some features may not work until "
"network access is enabled."
msgstr ""
"Esta aplicación parece usar la red. Algunas funciones no irán hasta que se "
"permita el acceso a la red."

#: crates/sam-core/src/warnings.rs:182
msgid "System D-Bus requested"
msgstr "Se pide el D-Bus del sistema"

#: crates/sam-core/src/warnings.rs:182
msgid ""
"The system bus controls hardware, networking, power and package management. "
"Grant only to apps you trust."
msgstr ""
"El bus del sistema controla el hardware, la red, la energía y la gestión de "
"paquetes. Permítalo solo a aplicaciones de confianza."

#: crates/sam-core/src/warnings.rs:192
msgid "Full session D-Bus"
msgstr "D-Bus de sesión completo"

#: crates/sam-core/src/warnings.rs:192
msgid ""
"Unfiltered session bus access lets the app control other desktop "
"applications and services, and can be used to escape the sandbox."
msgstr ""
"El acceso sin filtrar al bus de sesión permite que la aplicación controle "
"otras aplicaciones y servicios del escritorio, y puede servir para escapar "
"del entorno aislado."

#: crates/sam-core/src/warnings.rs:204
msgid "Dangerous D-Bus access"
msgstr "Acceso peligroso a D-Bus"

#. Keep the {placeholders}; their order may change.
#: crates/sam-core/src/warnings.rs:207
msgid ""
"Allowed session service: {why}. This can let the app escape the sandbox."
msgstr ""
"Servicio de sesión permitido: {why}. Esto puede permitir que la aplicación "
"escape del entorno aislado."

#: crates/sam-core/src/warnings.rs:215
msgid "D-Bus filtering unavailable"
msgstr "Filtro de D-Bus no disponible"

#: crates/sam-core/src/warnings.rs:215
msgid ""
"xdg-dbus-proxy is not installed, so the filtered session bus is disabled. "
"Install xdg-dbus-proxy."
msgstr ""
"xdg-dbus-proxy no está instalado, así que el bus de sesión filtrado está "
"desactivado. Instala xdg-dbus-proxy."

#: crates/sam-core/src/warnings.rs:224
msgid "Raw device access"
msgstr "Acceso directo a dispositivos"

#: crates/sam-core/src/warnings.rs:224
msgid ""
"Raw input, USB or sound devices are exposed. Input devices can be used to "
"log keystrokes."
msgstr ""
"Los dispositivos de entrada, USB o sonido están expuestos directamente. Los "
"de entrada pueden usarse para registrar pulsaciones de teclas."

#: crates/sam-core/src/warnings.rs:232
msgid ""
"Bluetooth requires system D-Bus access (BlueZ), which SAM cannot filter. The "
"toggle is ignored unless the system bus is granted."
msgstr ""
"Bluetooth necesita acceso al D-Bus del sistema (BlueZ), que SAM no puede "
"filtrar. El interruptor no tiene efecto mientras no se permita el bus del "
"sistema."

#: crates/sam-core/src/warnings.rs:241
msgid "Raw backend arguments"
msgstr "Argumentos directos del motor"

#: crates/sam-core/src/warnings.rs:241
msgid ""
"Custom backend arguments are passed through unchecked and may weaken the "
"sandbox."
msgstr ""
"Los argumentos propios del motor se pasan sin comprobar y pueden debilitar "
"el entorno aislado."

#: crates/sam-core/src/warnings.rs:248
msgid "Experimental seccomp filter"
msgstr "Filtro seccomp experimental"

#: crates/sam-core/src/warnings.rs:248
msgid ""
"Strict syscall filtering is experimental and can break apps (for example, "
"Electron apps that need nested namespaces)."
msgstr ""
"El filtrado estricto de llamadas al sistema es experimental y puede romper "
"aplicaciones (por ejemplo, las de Electron que necesitan espacios de nombres "
"anidados)."

#: crates/sam-core/src/warnings.rs:257
msgid "User namespaces unavailable"
msgstr "Espacios de nombres de usuario no disponibles"

#: crates/sam-core/src/warnings.rs:264 crates/sam-sandbox/src/lib.rs:989
msgid "Wayland socket not available"
msgstr "Socket de Wayland no disponible"

#: crates/sam-core/src/warnings.rs:264
msgid ""
"The Wayland socket is not available. Enable X11 or log in to a Wayland "
"session."
msgstr ""
"El socket de Wayland no está disponible. Activa X11 o inicia sesión en una "
"sesión de Wayland."

#: crates/sam-core/src/warnings.rs:271 crates/sam-sandbox/src/lib.rs:1009
msgid "X11 display not available"
msgstr "Pantalla X11 no disponible"

#: crates/sam-core/src/warnings.rs:271
msgid "No X11 display was found ($DISPLAY is unset or its socket is missing)."
msgstr ""
"No se encontró ninguna pantalla X11 ($DISPLAY no está definida o falta su "
"socket)."

#: crates/sam-core/src/warnings.rs:278
msgid "Sound server not found"
msgstr "No se encontró el servidor de sonido"

#: crates/sam-core/src/warnings.rs:282
msgid ""
"PipeWire runs without its PulseAudio service (pipewire-pulse), which "
"sandboxed apps use for sound. Install or start pipewire-pulse."
msgstr ""
"PipeWire funciona sin su servicio PulseAudio (pipewire-pulse), que usan las "
"aplicaciones aisladas para el sonido. Instala o inicia pipewire-pulse."

#: crates/sam-core/src/warnings.rs:286
msgid "No PulseAudio or PipeWire sound server was found. Audio may not work."
msgstr ""
"No se encontró ningún servidor de sonido PulseAudio ni PipeWire. Puede que "
"el sonido no funcione."

#: crates/sam-detect/src/appimage.rs:102
msgid "type 1 magic present but no ISO 9660 signature found"
msgstr "hay marca de tipo 1, pero no se encontró la firma ISO 9660"

#. Keep the {placeholders}; their order may change.
#: crates/sam-detect/src/appimage.rs:128
msgid "SquashFS found by scanning at offset {off}"
msgstr "SquashFS encontrado al buscar en la posición {off}"

#: crates/sam-detect/src/appimage.rs:140
msgid ""
"The AppImage marker is missing; it is treated as Type 2 because it contains "
"a SquashFS image"
msgstr ""
"Falta la marca de AppImage; se trata como tipo 2 porque contiene una imagen "
"SquashFS"

#: crates/sam-detect/src/appimage.rs:143
msgid "The AppImage marker is present, but the file contains no app image"
msgstr ""
"La marca de AppImage está presente, pero el archivo no contiene ninguna "
"imagen de aplicación"

#. Keep the {placeholders}; their order may change.
#: crates/sam-detect/src/appimage.rs:248
msgid ""
"it is built for {app} processors, but this computer's processor is {host}, "
"so it cannot run here. Download the {version} version of the app instead"
msgstr ""
"está hecho para procesadores {app}, pero el procesador de este equipo es "
"{host}, así que no puede funcionar aquí. Descarga en su lugar la versión "
"{version} de la aplicación"

#: crates/sam-detect/src/classify.rs:247
msgid "GPU device nodes"
msgstr "Nodos de dispositivo de la GPU"

#: crates/sam-detect/src/classify.rs:253
msgid "GL vendor dispatch metadata"
msgstr "Metadatos de distribución de GL por fabricante"

#. Keep the {placeholders}; their order may change.
#: crates/sam-detect/src/elf.rs:473
msgid ""
"{n} bundled program built for musl (Alpine) skipped: an alternative that "
"only runs on musl systems"
msgid_plural ""
"{n} bundled programs built for musl (Alpine) skipped: alternatives that only "
"run on musl systems"
msgstr[0] ""
"{n} programa incluido para musl (Alpine) omitido: una alternativa que solo "
"funciona en sistemas musl"
msgstr[1] ""
"{n} programas incluidos para musl (Alpine) omitidos: alternativas que solo "
"funcionan en sistemas musl"

#. Keep the {placeholders}; their order may change.
#: crates/sam-detect/src/elf.rs:481
msgid ""
"{n} bundled file built for another processor skipped: it is never loaded here"
msgid_plural ""
"{n} bundled files built for another processor skipped: they are never loaded "
"here"
msgstr[0] ""
"{n} archivo incluido para otro procesador omitido: aquí nunca se carga"
msgstr[1] ""
"{n} archivos incluidos para otro procesador omitidos: aquí nunca se cargan"

#: crates/sam-detect/src/elf.rs:503
msgid "Electron app: Chromium's internal sandbox needs nested user namespaces"
msgstr ""
"Aplicación de Electron: el entorno aislado interno de Chromium necesita "
"espacios de nombres de usuario anidados"

#. Keep the {placeholders}; their order may change.
#: crates/sam-detect/src/elf.rs:685
msgid "The app sets Qt to X11 itself (unless {var} says otherwise)"
msgstr ""
"La aplicación fija Qt en X11 por su cuenta (salvo que {var} indique otra "
"cosa)"

#: crates/sam-detect/src/elf.rs:715
msgid "A program of the app loads OpenGL or Vulkan at run time"
msgstr ""
"Un programa de la aplicación carga OpenGL o Vulkan durante la ejecución"

#: crates/sam-detect/src/elf.rs:803
msgid "Libraries not found"
msgstr "No se encontraron bibliotecas"

#. Keep the {placeholders}; their order may change.
#: crates/sam-detect/src/elf.rs:806
msgid ""
"The app's main program needs libraries, directly or through the libraries it "
"brings, that are neither bundled nor installed on this computer: "
"{libraries}. It will probably not start."
msgstr ""
"El programa principal de la aplicación necesita bibliotecas, directamente o "
"a través de las que incluye, que no vienen incluidas ni están instaladas en "
"este equipo: {libraries}. Probablemente no se inicie."

#: crates/sam-detect/src/elf.rs:817
msgid "Libraries not found for a program inside the app"
msgstr "No se encontraron bibliotecas para un programa de la aplicación"

#. Keep the {placeholders}; their order may change.
#: crates/sam-detect/src/elf.rs:820
msgid ""
"{programs} inside the app needs libraries that are neither bundled nor "
"installed: {libraries}. If the app uses that program, that part fails; often "
"it is a helper tool the app does not need to start."
msgstr ""
"{programs} dentro de la aplicación necesita bibliotecas que no vienen "
"incluidas ni están instaladas: {libraries}. Si la aplicación usa ese "
"programa, esa parte falla; a menudo es una herramienta auxiliar que la "
"aplicación no necesita para iniciarse."

#: crates/sam-detect/src/elf.rs:833
msgid "Uses this computer's system libraries"
msgstr "Usa las bibliotecas del sistema de este equipo"

#. Keep the {placeholders}; their order may change.
#: crates/sam-detect/src/elf.rs:836
msgid ""
"Like most AppImages, it uses this computer's copy of {libraries} instead of "
"bringing its own. If it ever crashes right at the start after a system "
"update, this is a likely cause."
msgstr ""
"Como la mayoría de los AppImage, usa la copia de {libraries} de este equipo "
"en lugar de traer la suya. Si alguna vez se cierra nada más iniciarse tras "
"una actualización del sistema, es una causa probable."

#: crates/sam-detect/src/elf.rs:850
