#: crates/sam-core/src/permissions.rs:324
msgid "controls the session (log out, restore programs)"
msgstr "controla la sesión (cerrar sesión, restaurar programas)"

#: crates/sam-core/src/permissions.rs:328
msgid "can register global shortcuts and observe key presses"
msgstr "puede registrar atajos globales y observar las pulsaciones de teclas"

#: crates/sam-core/src/permissions.rs:336
msgid "controls the session"
msgstr "controla la sesión"

#: crates/sam-core/src/permissions.rs:340
msgid "can change any desktop setting, including autostart"
msgstr ""
"puede cambiar cualquier ajuste del escritorio, incluido el inicio automático"

#: crates/sam-core/src/permissions.rs:354
msgid "controls Docker, which equals full control of the computer"
msgstr "controla Docker, lo que equivale al control total del equipo"

#: crates/sam-core/src/permissions.rs:358
msgid "controls Podman containers on this computer"
msgstr "controla los contenedores de Podman de este equipo"

#: crates/sam-core/src/permissions.rs:362
msgid "controls containers on this computer"
msgstr "controla los contenedores de este equipo"

#: crates/sam-core/src/permissions.rs:366
msgid "is the system bus, unfiltered"
msgstr "es el bus del sistema, sin filtrar"

#: crates/sam-core/src/permissions.rs:368
msgid "controls systemd"
msgstr "controla systemd"

#: crates/sam-core/src/permissions.rs:371
