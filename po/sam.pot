msgid "SSH keys"
msgstr ""

#: crates/sam-core/src/permissions.rs:1240
msgid "With full home access, also exposes ~/.ssh. Your SSH private keys could be stolen."
msgstr ""

#: crates/sam-core/src/permissions.rs:1242 crates/sam-core/src/risk.rs:230
msgid "GnuPG keys"
msgstr ""

#: crates/sam-core/src/permissions.rs:1242
msgid "With full home access, also exposes ~/.gnupg. Your PGP private keys could be stolen."
msgstr ""

#: crates/sam-core/src/permissions.rs:1244 crates/sam-core/src/risk.rs:238
msgid "Sensitive dotfiles"
msgstr ""

#: crates/sam-core/src/permissions.rs:1244
msgid "With full home access, also exposes keyrings, password stores and cloud credentials."
msgstr ""

#: crates/sam-core/src/permissions.rs:1246
msgid "Files you open with the app"
msgstr ""

#: crates/sam-core/src/permissions.rs:1246
msgid "Files you open with this app (for example with 'Open with' in the file manager). Read & write lets it save them; read-only lets it only view them; no access shares none of them with the app."
msgstr ""

#: crates/sam-core/src/permissions.rs:1248
msgid "Extra read-only folders"
msgstr ""

#: crates/sam-core/src/permissions.rs:1248
msgid "Additional folders the app can read but not change. Programs that listen in them stay reachable: read-only does not stop the app from connecting to them (for example to a terminal session in /tmp)."
msgstr ""

#: crates/sam-core/src/permissions.rs:1250
msgid "Extra read/write folders"
msgstr ""

#: crates/sam-core/src/permissions.rs:1250
msgid "Additional folders the app can read and change."
msgstr ""

#: crates/sam-core/src/permissions.rs:1252
msgid "Network access"
msgstr ""

#: crates/sam-core/src/permissions.rs:1252
msgid "'Full network' shares your internet connection with the app. 'This computer only' blocks the internet and the local network, but keeps the services on this computer that you list reachable (for example a local AI model), and the app's own web page opens in your browser. 'No network' gives the app no connection at all."
msgstr ""

#: crates/sam-core/src/permissions.rs:1254
msgid "Local services the app may reach"
msgstr ""

#: crates/sam-core/src/permissions.rs:1254
msgid "With 'This computer only': ports on this computer the app may connect to, for example 11434 for Ollama or 1234 for LM Studio. Nothing else on your computer is reachable."
msgstr ""

#: crates/sam-core/src/permissions.rs:1256
msgid "The app's own ports"
msgstr ""

#: crates/sam-core/src/permissions.rs:1256
msgid "With 'This computer only': ports of the app (for example its web page) reachable from this computer. When empty, SAM detects them, except privileged ports and well-known local services."
msgstr ""

#: crates/sam-core/src/permissions.rs:1258 crates/sam-core/src/risk.rs:293
msgid "GPU acceleration"
msgstr ""

#: crates/sam-core/src/permissions.rs:1258
msgid "Hardware-accelerated graphics through /dev/dri and host graphics drivers. Needed by most games, browsers and editors."
msgstr ""

#: crates/sam-core/src/permissions.rs:1260 crates/sam-core/src/risk.rs:301 crates/sam-core/src/warnings.rs:453 crates/sam-runner/src/verify.rs:567
msgid "Webcam"
msgstr ""

#: crates/sam-core/src/permissions.rs:1260
msgid "Access to video capture devices. The app could record you."
msgstr ""

#: crates/sam-core/src/permissions.rs:1262 crates/sam-core/src/risk.rs:304
msgid "Game controllers"
msgstr ""

#: crates/sam-core/src/permissions.rs:1262
msgid "Gamepads and joysticks that are plugged in when the app starts. One that is unplugged is taken away from the app at once, or SAM ends the app where it cannot do that safely, so a device plugged in later never takes its place. Keyboards and mice stay hidden, and so does a controller that also reports itself as a keyboard or mouse."
msgstr ""

#: crates/sam-core/src/permissions.rs:1264 crates/sam-core/src/risk.rs:312 crates/sam-runner/src/verify.rs:581
msgid "All input devices"
msgstr ""

#: crates/sam-core/src/permissions.rs:1264
msgid "Raw access to every keyboard, mouse and controller in /dev/input, and a virtual input device (/dev/uinput): the app can read every keystroke and type or move the mouse as if it were you. Only for tools that remap or configure input devices."
msgstr ""

#: crates/sam-core/src/permissions.rs:1266 crates/sam-core/src/risk.rs:320 crates/sam-runner/src/verify.rs:618
msgid "Raw USB"
msgstr ""

#: crates/sam-core/src/permissions.rs:1266
msgid "Raw access to USB devices. Needed by flashing tools and some hardware utilities."
msgstr ""

#: crates/sam-core/src/permissions.rs:1268 crates/sam-core/src/risk.rs:323 crates/sam-core/src/warnings.rs:515
msgid "Bluetooth"
msgstr ""

#: crates/sam-core/src/permissions.rs:1268
msgid "Lets the app open Bluetooth sockets, which reach nearby devices only with full network access. Without it, the app's syscall filter refuses them while the filter is on, except for an app whose start program is 32-bit (the security page says why). An app that may reach the Bluetooth service on the system D-Bus can use Bluetooth devices through it, with or without this switch."
msgstr ""

#: crates/sam-core/src/permissions.rs:1270 crates/sam-core/src/risk.rs:331 crates/sam-runner/src/verify.rs:531
msgid "Sound"
msgstr ""

#: crates/sam-core/src/permissions.rs:1270
msgid "Play and record audio (through PipeWire's PulseAudio service). Recording is possible once this is on."
msgstr ""

#: crates/sam-core/src/permissions.rs:1272 crates/sam-core/src/risk.rs:350 crates/sam-runner/src/launch.rs:2304
msgid "Sound without SAM's relay"
msgstr ""

#: crates/sam-core/src/permissions.rs:1272
msgid "Only for computers where SAM's sound relay cannot run (a sound server without PipeWire). The app then talks to your sound server directly and could make it load code outside the sandbox. SAM warns at every start."
msgstr ""

#: crates/sam-core/src/permissions.rs:1274 crates/sam-core/src/risk.rs:342 crates/sam-runner/src/verify.rs:541
msgid "Direct PipeWire access"
msgstr ""

#: crates/sam-core/src/permissions.rs:1274
msgid "The full PipeWire connection. Besides sound it reaches cameras and screen-cast streams of other apps, bypassing the webcam and screen sharing settings. Only for apps that support nothing else."
msgstr ""

#: crates/sam-core/src/permissions.rs:1276 crates/sam-core/src/risk.rs:358 crates/sam-runner/src/verify.rs:629
msgid "Raw ALSA devices"
msgstr ""

#: crates/sam-core/src/permissions.rs:1276
msgid "Direct sound card access. Only needed by apps that do not support PipeWire/PulseAudio."
msgstr ""

#: crates/sam-core/src/permissions.rs:1278 crates/sam-core/src/risk.rs:366 crates/sam-runner/src/verify.rs:500
msgid "Wayland"
msgstr ""

#: crates/sam-core/src/permissions.rs:1278
msgid "Show windows through the Wayland compositor. Wayland isolates apps from each other."
msgstr ""

#: crates/sam-core/src/permissions.rs:1280 crates/sam-core/src/risk.rs:334 crates/sam-core/src/warnings.rs:475
msgid "Privileged Wayland protocols"
msgstr ""

#: crates/sam-core/src/permissions.rs:1280
msgid "Lets the app use Wayland functions the desktop normally hides from sandboxed apps: reading the clipboard in the background, capturing the screen, typing as a virtual keyboard. Only for clipboard managers, screenshot and remote-control tools."
msgstr ""

#: crates/sam-core/src/permissions.rs:1282 crates/sam-core/src/risk.rs:417 crates/sam-runner/src/verify.rs:508
msgid "X11 / XWayland"
msgstr ""

#: crates/sam-core/src/permissions.rs:1282 crates/sam-core/src/warnings.rs:289
msgid "X11 access allows the app to observe input and other windows. Wayland is safer, but some apps may require XWayland."
msgstr ""

#: crates/sam-core/src/permissions.rs:1284 crates/sam-runner/src/verify.rs:659
msgid "Session bus"
msgstr ""

#: crates/sam-core/src/permissions.rs:1284
msgid "'filtered' only allows portals, notifications and the tray. 'full' lets the app talk to every desktop service, including systemd, through which it can start programs outside its sandbox."
msgstr ""

#: crates/sam-core/src/permissions.rs:1286
msgid "Allowed session names"
msgstr ""

#: crates/sam-core/src/permissions.rs:1286
msgid "Bus names reachable in filtered mode."
msgstr ""

#: crates/sam-core/src/permissions.rs:1288 crates/sam-runner/src/verify.rs:734
msgid "System bus"
msgstr ""

#: crates/sam-core/src/permissions.rs:1288
msgid "The system bus controls hardware, networking and power. Denied by default."
msgstr ""

#: crates/sam-core/src/permissions.rs:1290 crates/sam-core/src/risk.rs:369 crates/sam-core/src/warnings.rs:443
msgid "Passwords & keyring"
msgstr ""

#: crates/sam-core/src/permissions.rs:1290
msgid "Lets the app store logins in your keyring or KWallet. The keyring does not separate apps: the app can read every password stored there."
msgstr ""

#: crates/sam-core/src/permissions.rs:1292 crates/sam-core/src/risk.rs:377
msgid "Media controls"
msgstr ""

#: crates/sam-core/src/permissions.rs:1292
msgid "Media keys and 'now playing' in the panel, and keeping the screen awake during playback."
msgstr ""

#: crates/sam-core/src/permissions.rs:1294 crates/sam-core/src/risk.rs:385
msgid "Screen sharing"
msgstr ""

#: crates/sam-core/src/permissions.rs:1294
msgid "Lets the app ask to share your screen or a window (video calls, streaming). Your desktop always asks which screen or window first."
msgstr ""

#: crates/sam-core/src/permissions.rs:1296 crates/sam-core/src/risk.rs:401
msgid "Open the file manager"
msgstr ""

#: crates/sam-core/src/permissions.rs:1296
msgid "Lets the app open your file manager and show a file it saved there (\"Show in folder\")."
msgstr ""

#: crates/sam-core/src/permissions.rs:1298 crates/sam-core/src/risk.rs:393
msgid "Input method"
msgstr ""

#: crates/sam-core/src/permissions.rs:1298
msgid "Typing through Fcitx5 or IBus (their sandbox frontends), for example for Chinese, Japanese or Korean, and emoji pickers."
msgstr ""

#: crates/sam-core/src/permissions.rs:1300 crates/sam-core/src/risk.rs:512 crates/sam-core/src/warnings.rs:465 crates/sam-runner/src/verify.rs:747
msgid "SSH agent"
msgstr ""

#: crates/sam-core/src/permissions.rs:1300
msgid "Lets the app use the keys loaded in your SSH agent: it can log in to other computers and sign as you while the keys are unlocked."
msgstr ""

#: crates/sam-core/src/permissions.rs:1302 crates/sam-core/src/risk.rs:520 crates/sam-runner/src/verify.rs:757
msgid "Printing"
msgstr ""

#: crates/sam-core/src/permissions.rs:1302
msgid "Access to the CUPS printing service."
msgstr ""

#: crates/sam-core/src/permissions.rs:1304
msgid "Extra sockets"
msgstr ""

#: crates/sam-core/src/permissions.rs:1304
msgid "Paths of other service sockets the app may connect to, for example a password manager's browser connection. The app can do whatever that service allows. Only real socket files are passed into the sandbox."
msgstr ""

#: crates/sam-core/src/permissions.rs:1306
msgid "Names the app may own"
msgstr ""

#: crates/sam-core/src/permissions.rs:1306
msgid "Extra bus names the app may register with the filtered session bus, for apps that do not start without their own name. Owning a well-known name lets the app pose as that service."
msgstr ""

#: crates/sam-core/src/permissions.rs:1308
msgid "Single functions of services"
msgstr ""

#: crates/sam-core/src/permissions.rs:1308
msgid "Functions of a service the app may call although it may not talk to the service otherwise, written NAME=[FUNCTION][@PATH]. A function of a service that can act outside the sandbox (systemd, the desktop shell) is a way out."
msgstr ""

#: crates/sam-core/src/permissions.rs:1310
msgid "Signals of services"
msgstr ""

#: crates/sam-core/src/permissions.rs:1310
msgid "Signals of a service the app may receive although it may not talk to the service otherwise, written NAME=[SIGNAL][@PATH]. The app learns what the service announces."
msgstr ""

#: crates/sam-core/src/permissions.rs:1312
msgid "Always blocked names"
msgstr ""

#: crates/sam-core/src/permissions.rs:1312
msgid "Bus names that stay blocked even when a preset or another setting allows them: for talking, owning, calls and signals; org.example.* blocks every name below it. The filter works per program: a program that also holds a name you allow can still be reached through that name."
msgstr ""

#: crates/sam-core/src/permissions.rs:1314
msgid "Passed-through variables"
msgstr ""

#: crates/sam-core/src/permissions.rs:1314
msgid "Host environment variables made visible to the app."
msgstr ""

#: crates/sam-core/src/permissions.rs:1316
msgid "Environment variables"
msgstr ""

#: crates/sam-core/src/permissions.rs:1316
msgid "Variables set inside the sandbox, as NAME=value, for example QT_SCALE_FACTOR=1.5. They override variables passed through."
msgstr ""

#: crates/sam-core/src/permissions.rs:1318
msgid "Host runtime exposure"
msgstr ""

#: crates/sam-core/src/permissions.rs:1318
msgid "'minimal' exposes system libraries and a whitelist of shared data. 'full' exposes all of /usr read-only (compatibility)."
msgstr ""

#: crates/sam-core/src/permissions.rs:1320
msgid "Persistent private home"
msgstr ""

#: crates/sam-core/src/permissions.rs:1320
msgid "Keep the app's own private settings folder between runs."
msgstr ""

#: crates/sam-core/src/permissions.rs:1322
msgid "Landlock enforcement"
msgstr ""

#: crates/sam-core/src/permissions.rs:1322
msgid "Kernel-enforced write restrictions as an extra layer. Unset follows the global setting."
msgstr ""

#: crates/sam-core/src/permissions.rs:1324
msgid "Strict syscall filter"
msgstr ""

#: crates/sam-core/src/permissions.rs:1324
msgid "Experimental: blocks rarely needed, dangerous system calls. Can break apps."
msgstr ""

#: crates/sam-core/src/permissions.rs:1326 crates/sam-gtk/src/pages.rs:313
msgid "Baseline syscall filter"
msgstr ""

#: crates/sam-core/src/permissions.rs:1326
msgid "Blocks kernel interfaces no desktop app needs (modules, BPF, perf, keyrings, io_uring, terminal injection). Turn off only if an app fails because of it."
msgstr ""

#: crates/sam-core/src/permissions.rs:1328 crates/sam-core/src/warnings.rs:505
msgid "Nested namespaces"
msgstr ""

#: crates/sam-core/src/permissions.rs:1328
msgid "Lets Chromium/Electron apps start their own internal sandbox."
msgstr ""

#: crates/sam-core/src/permissions.rs:1330
msgid "Room service"
msgstr ""

#: crates/sam-core/src/permissions.rs:1330
msgid "Programs that build a sandbox of their own (such as GTK's image loader) get it from SAM, never with more than the app. Turned off, they run without their own sandbox or fail."
