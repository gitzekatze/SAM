msgstr "Désactive « {setting} ». {explanation}"

#. Keep the {placeholders}; their order may change.
#: crates/sam-runner/src/repair.rs:627
msgid "Turns on “{setting}”. {explanation}"
msgstr "Active « {setting} ». {explanation}"

#. Keep the {placeholders}; their order may change.
