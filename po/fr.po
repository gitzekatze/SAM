msgstr "contrôle les services d’arrière-plan du bureau"

#: crates/sam-core/src/permissions.rs:346
msgid "can run commands"
msgstr "peut exécuter des commandes"

#: crates/sam-core/src/permissions.rs:349
msgid "controls the session (log out, restore programs)"
msgstr "contrôle la session (déconnexion, restauration des programmes)"

#: crates/sam-core/src/permissions.rs:353
msgid "can register global shortcuts and observe key presses"
msgstr ""
"peut enregistrer des raccourcis globaux et observer les frappes au clavier"

#: crates/sam-core/src/permissions.rs:361
msgid "controls the session"
msgstr "contrôle la session"

#: crates/sam-core/src/permissions.rs:365
msgid "can change any desktop setting, including autostart"
msgstr ""
"peut modifier n’importe quel réglage du bureau, y compris le démarrage "
"automatique"

#: crates/sam-core/src/permissions.rs:379
#: crates/sam-core/src/permissions.rs:383
#: crates/sam-core/src/permissions.rs:387
#: crates/sam-core/src/permissions.rs:391
#: crates/sam-core/src/permissions.rs:395
#: crates/sam-core/src/permissions.rs:399
msgid "can run any command in a terminal outside the sandbox"
msgstr ""
"peut exécuter n’importe quelle commande dans un terminal hors du bac à sable"

#: crates/sam-core/src/permissions.rs:447
msgid ""
"is a key agent: the app can use your unlocked keys to decrypt, sign or log "
"in to other computers as you"
msgstr ""
"est un agent de clés : l’application peut utiliser tes clés déverrouillées "
"pour déchiffrer, signer ou se connecter à d’autres ordinateurs en ton nom"

#: crates/sam-core/src/permissions.rs:510
msgid "controls Docker, which equals full control of the computer"
msgstr "contrôle Docker, ce qui équivaut au contrôle total de l’ordinateur"

#: crates/sam-core/src/permissions.rs:514
msgid "controls Podman containers on this computer"
msgstr "contrôle les conteneurs Podman de cet ordinateur"

#: crates/sam-core/src/permissions.rs:518
msgid "controls containers on this computer"
msgstr "contrôle les conteneurs de cet ordinateur"

#: crates/sam-core/src/permissions.rs:522
msgid "is the system bus, unfiltered"
msgstr "est le bus système, non filtré"

#: crates/sam-core/src/permissions.rs:524
msgid "controls systemd"
msgstr "contrôle systemd"

#: crates/sam-core/src/permissions.rs:527
msgid "is a D-Bus socket, which bypasses SAM's D-Bus filter"
msgstr "est un socket D-Bus, qui contourne le filtre D-Bus de SAM"

#: crates/sam-core/src/permissions.rs:529
msgid "controls virtual machines"
msgstr "contrôle des machines virtuelles"

#: crates/sam-core/src/permissions.rs:534
msgid ""
"is the sound server's own connection, through which the app could make it "
"load code outside the sandbox"
msgstr ""
"est la connexion propre du serveur audio, par laquelle l’application "
"pourrait lui faire charger du code hors du bac à sable"

