#~ msgid ""
#~ "SAM does not show {path} to this app because the way there leads through "
#~ "the link {link}, which lies in a folder the app can change, to a place "
#~ "the home and the user folders do not show: the app may have made that "
#~ "link. The app still sees what its other folders show there. If you made "
#~ "the link yourself, add the place it leads to as an extra folder: SAM "
#~ "still leaves out {path} then, but where the app's other folders show the "
#~ "link, the app reaches that place through it."
